{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "project_name": "CareerEngineHR",
  "stack": "career-strategy-playwright",
  "agent_runtime": "antigravity",
  "commands": {
    "test_runner": "python -c \"import fitz, glob; pdfs = glob.glob('*.pdf'); assert all(len(fitz.open(p)) == 2 for p in pdfs), 'PDF page count != 2'\"",
    "linter": "flake8 --max-line-length=120",
    "health_check": "python Scripts_Generadores/build_cv.py",
    "build_release": "python Scripts_Generadores/build_cv.py && python Scripts_Generadores/build_cv_ats.py"
  },
  "domains": {
    "candidate_strategy": "CONTEXTO_ESTRATEGIA_IA.md",
    "cv_content": ".agents/memory/00_cv_content_blueprint.md",
    "interview_strategy": "CHULETA_LLAMADAS_ENTREVISTAS.md",
    "ats_optimization": ".agents/memory/01_ats_optimization.md",
    "playwright_engine": ".agents/memory/02_playwright_engine.md",
    "confidentiality_governance": ".agents/memory/03_confidentiality_governance.md",
    "cross_project_audit": ".agents/memory/04_cross_project_audit.md"
  },
  "invariants": {
    "strict_two_pages_a4": true,
    "zero_overflow": true,
    "zero_confidentiality_leakage": true,
    "zero_touch_external_projects": true,
    "max_rag_domain_files_per_session": 3,
    "anti_overfetching": true
  },
  "mcp_servers": {
    "required": [
      "chrome-devtools",
      "github"
    ],
    "config_file": ".agents/mcp_config.json",
    "security_protocol": ".agents/MCP_SECURITY.md"
  }
}
