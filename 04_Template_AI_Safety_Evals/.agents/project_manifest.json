{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "project_name": "TemplateAISafetyEvals",
  "stack": "ai-safety-security-evals",
  "frameworks": [
    "python",
    "pytest",
    "firebase-tools",
    "owasp-masvs",
    "owasp-llm-top-10"
  ],
  "agent_runtime": "antigravity",
  "commands": {
    "test_runner": "python -m unittest discover -s scripts/ -p 'test_*.py'",
    "health_check": "python scripts/verify_audit_engine.py",
    "eval_prompt_injection": "python scripts/eval_prompt_injection.py",
    "eval_truthfulness": "python scripts/eval_truthfulness.py",
    "check_firestore_rules": "python scripts/check_firestore_rules.py",
    "check_masvs_mobile": "python scripts/check_masvs_mobile.py"
  },
  "domains": {
    "vulnerabilities_registry": ".agents/memory/01_vulnerabilities_registry.md",
    "mitigations_playbook": ".agents/memory/02_mitigations_playbook.md",
    "llm_evals_benchmarks": ".agents/memory/03_llm_evals_benchmarks.md",
    "cloud_rules_hardening": ".agents/memory/04_cloud_rules_hardening.md",
    "masvs_mobile_security": ".agents/memory/05_masvs_mobile_security.md"
  },
  "invariants": {
    "safety_score_target": 95,
    "zero_unmitigated_criticals": true,
    "strict_evidence_gate": true,
    "max_rag_domain_files_per_session": 3,
    "mandatory_legal_disclaimers": [
      "Ley 7/2023"
    ]
  },
  "mcp_servers": {
    "required": [
      "huggingface",
      "github",
      "firebase"
    ],
    "config_file": ".agents/mcp_config.json",
    "security_protocol": ".agents/MCP_SECURITY.md"
  }
}
